[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/skills/dash_bar_slot.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/hud/hud_tooltip_button.gd" id="2_tooltip"]
[ext_resource type="Texture2D" path="res://assets/ui/hud/eclipse_bind/eclipse_dash_24.png" id="3_icon"]

[sub_resource type="StyleBoxFlat" id="cooldown_fill"]
bg_color = Color(0.38, 0.7, 0.87, 1)

[node name="DashBarSlot" type="Panel"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Icon" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 8.0
offset_top = 9.0
offset_right = 32.0
offset_bottom = 33.0
mouse_filter = 2
texture = ExtResource("3_icon")
expand_mode = 1
stretch_mode = 5

[node name="KeyLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 3.0
offset_top = 0.0
offset_right = 37.0
offset_bottom = 12.0
mouse_filter = 2
text = "SPACE"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.85, 0.93, 1, 1)
theme_override_colors/font_outline_color = Color(0.02, 0.02, 0.03, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 7

[node name="StateLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 0
offset_left = 1.0
offset_top = 17.0
offset_right = 39.0
offset_bottom = 30.0
mouse_filter = 2
text = "DODGE"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.87, 0.95, 1, 1)
theme_override_colors/font_outline_color = Color(0.01, 0.02, 0.03, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 8

[node name="CooldownBar" type="ProgressBar" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 9.0
offset_top = 35.0
offset_right = 31.0
offset_bottom = 37.0
mouse_filter = 2
show_percentage = false
theme_override_styles/fill = SubResource("cooldown_fill")

[node name="CooldownTick" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.1

[node name="ActivationButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
focus_mode = 2
mouse_default_cursor_shape = 2
flat = true
script = ExtResource("2_tooltip")

[connection signal="timeout" from="CooldownTick" to="." method="_on_cooldown_tick"]
[connection signal="pressed" from="ActivationButton" to="." method="_on_activation_button_pressed"]
