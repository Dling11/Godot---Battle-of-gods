; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Battle of Gods"
run/main_scene="res://ui/screens/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SceneTransition="*res://autoload/scene_transition.gd"
AudioDirector="*res://autoload/audio_director.gd"
DebugAdminState="*res://autoload/debug_admin_state.gd"
CursorService="*res://autoload/cursor_service.gd"
RunSession="*res://autoload/run_session.gd"
StoryState="*res://autoload/story_state.gd"
WeaponInventory="*res://autoload/weapon_inventory.gd"
GearInventory="*res://autoload/gear_inventory.gd"
MaterialInventory="*res://autoload/material_inventory.gd"
RecipeDiscovery="*res://autoload/recipe_discovery.gd"
CraftingService="*res://autoload/crafting_service.gd"
EnemyMemory="*res://autoload/enemy_memory.gd"
MaterialExchangeService="*res://autoload/material_exchange_service.gd"
LootState="*res://autoload/loot_state.gd"
LootService="*res://autoload/loot_service.gd"
SaveService="*res://autoload/save_service.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/handheld/orientation=1

